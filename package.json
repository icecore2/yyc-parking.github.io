{
  "name": "calgary-parking-map",
  "version": "1.0.0",
  "description": "Interactive static OpenStreetMap showing Calgary On-Street Parking Zones, rates, shapes, and details",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm --prefix webapp run build",
    "test": "node test/test_rates_parser.js && node test/test_providers.js && node test/test_ui_layering.js",
    "sync:run": "npm --prefix services/parking-sync run sync",
    "sync:test": "npm --prefix services/parking-sync run test",
    "sync:daemon": "npm --prefix services/parking-sync run sync:daemon",
    "webapp:dev": "npm --prefix webapp run dev",
    "webapp:build": "npm --prefix webapp run build",
    "webapp:start": "npm --prefix webapp run start",
    "webapp:test": "npm --prefix webapp run test"
  },
  "keywords": [
    "calgary",
    "parking",
    "leaflet",
    "openstreetmap",
    "arcgis"
  ],
  "author": "",
  "license": "MIT"
}
